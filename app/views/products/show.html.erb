<div class="max-w-5xl mx-auto py-8 px-4">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div>
      <% if @product.featured_image.attached? %>
        <%= image_tag @product.featured_image.variant(resize_to_limit: [600, 600]), class: "w-full rounded-lg" %>
      <% else %>
        <div class="w-full h-96 bg-gray-200 flex items-center justify-center rounded-lg">
          Không có ảnh
        </div>
      <% end %>
    </div>

    <div>
      <h1 class="text-3xl font-bold mb-2"><%= @product.name %></h1>

      <div class="flex items-center gap-3 mb-4">
        <span class="text-2xl font-bold text-red-600">
          <%= number_to_currency(@product.price, unit: "₫", precision: 0) %>
        </span>
        <% if @product.on_sale? %>
          <span class="text-lg text-gray-500 line-through">
            <%= number_to_currency(@product.compare_at_price, unit: "₫", precision: 0) %>
          </span>
        <% end %>
      </div>

      <p class="text-gray-700 mb-4"><%= simple_format(@product.description) %></p>

      <p class="mb-2"><strong>SKU:</strong> <%= @product.sku.presence || "—" %></p>
      <p class="mb-2"><strong>Tồn kho:</strong> <%= @product.inventory_count %></p>
      <p class="mb-4"><strong>Danh mục:</strong> <%= @product.category&.name || "Chưa phân loại" %></p>
      <div class="flex gap-3">
        <% if @product.inventory_count > 0 %>
            <%= form_with url: cart_items_path, method: :post, class: "mt-6 flex items-center gap-4" do %>
                <%= hidden_field_tag :product_id, @product.id %>
                <div>
                <%= label_tag :quantity, "Số lượng", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= number_field_tag :quantity, 1, min: 1, max: @product.inventory_count,
                        class: "w-24 rounded-md border-gray-300" %>
                </div>
                <%= submit_tag "Thêm vào giỏ hàng",
                    class: "bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 px-6 rounded-md" %>
        <% end %>
        <% else %>
            <p class="mt-6 text-red-600 font-medium">Sản phẩm tạm hết hàng</p>
        <% end %>
        <%= link_to "Sửa sản phẩm", edit_product_path(@product), class: "bg-blue-600 text-white px-4 py-2 rounded-md" %>
        <%= link_to "Xóa", @product, data: { turbo_method: :delete, turbo_confirm: "Bạn chắc chắn muốn xóa?" }, class: "bg-red-600 text-white px-4 py-2 rounded-md" %>
        <%= link_to "Quay lại danh sách", products_path, class: "text-gray-600 hover:underline self-center" %>
      </div>
    </div>
  </div>
</div>