<div class="mb-6">
  <h1 class="text-xl font-medium text-gray-700">Gợi ý hôm nay</h1>
</div>

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
  <% @products.each do |product| %>
    <%= link_to product_path(product), class: "bg-white rounded-sm shadow-sm hover:shadow-md transition group" do %>
      <!-- Ảnh -->
      <div class="relative aspect-square overflow-hidden">
        <% if product.featured_image.attached? %>
          <%= image_tag product.featured_image.variant(resize_to_limit: [300, 300]),
                class: "w-full h-full object-cover group-hover:scale-105 transition duration-300" %>
        <% else %>
          <div class="w-full h-full bg-gray-200 flex items-center justify-center text-gray-400 text-sm">
            No Image
          </div>
        <% end %>

        <% if product.on_sale? %>
          <div class="absolute top-0 right-0 bg-[#EE4D2D] text-white text-xs font-bold px-1.5 py-0.5">
            -<%= product.discount_percentage %>%
          </div>
        <% end %>
      </div>

      <!-- Thông tin -->
      <div class="p-2">
        <h3 class="text-sm text-gray-800 line-clamp-2 h-10 mb-1">
          <%= product.name %>
        </h3>

        <div class="flex items-baseline gap-1">
          <span class="text-[#EE4D2D] font-medium">
            ₫<%= number_with_delimiter(product.price.to_i) %>
          </span>
          <% if product.on_sale? %>
            <span class="text-xs text-gray-400 line-through">
              ₫<%= number_with_delimiter(product.compare_at_price.to_i) %>
            </span>
          <% end %>
        </div>

        <div class="text-xs text-gray-400 mt-1">
          Còn <%= product.inventory_count %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>