<% content_for :title, "Mua sắm online - Store" %>

<!-- Breadcrumb -->
<div class="py-3">
  <div class="flex items-center gap-2 text-sm text-gray-500">
    <%= link_to "Trang chủ", root_path, class: "text-[#ee4d2d] hover:underline" %>
    <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    <span class="text-gray-700">Tất cả sản phẩm</span>
  </div>
</div>

<!-- Category pills (giả lập Shopee Mall bar) -->
<div class="bg-white rounded-sm shadow-sm p-3 mb-4 flex gap-3 overflow-x-auto">
  <% Category.limit(8).each do |cat| %>
    <%= link_to cat.name, category_path(cat), class: "shrink-0 px-4 py-1.5 rounded-full bg-gray-50 hover:bg-[#ee4d2d] hover:text-white text-sm text-gray-600 transition-colors border border-gray-100" %>
  <% end %>
</div>

<!-- Flash Sale Banner -->
<div class="bg-white rounded-sm shadow-sm p-4 mb-4 flex items-center gap-3">
  <span class="text-[#ee4d2d] font-bold text-lg uppercase tracking-wide">⚡ Flash Sale</span>
  <div class="h-px flex-1 bg-gradient-to-r from-[#ee4d2d]/20 to-transparent"></div>
  <span class="text-sm text-gray-500">Xem tất cả ></span>
</div>

<!-- Product Grid -->
<% if @products.any? %>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-3">
    <% @products.each do |product| %>
      <%= link_to product, class: "group bg-white rounded-sm shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col" do %>
        <div class="relative aspect-square bg-gray-100 overflow-hidden">
          <% if product.featured_image.attached? %>
            <%= image_tag product.featured_image.variant(resize_to_limit: [400, 400]),
                  class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center text-gray-300">
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
          <% end %>

          <% if product.on_sale? %>
            <div class="absolute top-0 right-0 bg-[#ffce3d] text-[#ee4d2d] text-[10px] font-bold px-1.5 py-0.5 rounded-bl-sm">
              -<%= product.discount_percentage %>%
            </div>
          <% end %>

          <% if product.inventory_count == 0 %>
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center backdrop-blur-[1px]">
              <span class="text-white text-xs font-bold border border-white/80 px-3 py-1 rounded-sm tracking-wide">HẾT HÀNG</span>
            </div>
          <% end %>

          <!-- Shopee-style "Yêu thích" badge -->
          <div class="absolute top-2 left-0 bg-[#ee4d2d] text-white text-[10px] px-1.5 py-0.5 rounded-r-sm font-medium">Yêu thích</div>
        </div>

        <div class="p-2.5 flex flex-col flex-1">
          <p class="text-sm text-gray-800 line-clamp-2 leading-snug mb-1 flex-1 min-h-[2.5rem]"><%= product.name %></p>

          <div class="flex items-end gap-1.5 mb-1">
            <span class="text-[#ee4d2d] font-semibold text-base">
              <span class="text-xs align-top">₫</span><%= number_with_delimiter(product.price.to_i, delimiter: '.') %>
            </span>
            <% if product.on_sale? %>
              <span class="text-gray-300 text-xs line-through mb-0.5">
                ₫<%= number_with_delimiter(product.compare_at_price.to_i, delimiter: '.') %>
              </span>
            <% end %>
          </div>

          <div class="flex items-center justify-between mt-auto pt-1">
            <div class="flex items-center gap-1">
              <% 5.times do |i| %>
                <svg class="w-3 h-3 <%= i < 4 ? 'text-yellow-400 fill-current' : 'text-gray-200' %>" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <% end %>
              <span class="text-[11px] text-gray-400">Đã bán <%= product.sold_count > 999 ? '999+' : product.sold_count %></span>
            </div>
            <span class="text-[11px] text-gray-400">TP. Hồ Chí Minh</span>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-white rounded-sm shadow-sm text-center py-24 text-gray-400">
    <svg class="w-16 h-16 mx-auto mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
    <p>Chưa có sản phẩm nào.</p>
  </div>
<% end %>