<%# app/views/orders/show.html.erb %>
<div class="py-10 max-w-3xl mx-auto">
  <div class="bg-white rounded-sm shadow-sm p-8 text-center mb-4">
    <div class="w-16 h-16 rounded-full bg-green-50 flex items-center justify-center mx-auto mb-4">
      <span class="text-green-600 text-3xl">✓</span>
    </div>
    <h1 class="text-xl font-semibold text-gray-800 mb-1">Đặt hàng thành công!</h1>
    <p class="text-sm text-gray-500">
      Cảm ơn bạn đã mua sắm. Mã đơn hàng của bạn là <span class="font-medium text-gray-700">#<%= @order.id %></span>
    </p>
  </div>

  <div class="bg-white rounded-sm shadow-sm p-6 mb-4">
    <h2 class="text-base font-semibold text-gray-800 mb-4 pb-3 border-b">Thông Tin Giao Hàng</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <div>
        <p class="text-gray-400 mb-1">Người nhận</p>
        <p class="text-gray-700 font-medium"><%= @order.full_name %></p>
      </div>
      <div>
        <p class="text-gray-400 mb-1">Số điện thoại</p>
        <p class="text-gray-700 font-medium"><%= @order.phone %></p>
      </div>
      <div class="sm:col-span-2">
        <p class="text-gray-400 mb-1">Địa chỉ</p>
        <p class="text-gray-700 font-medium"><%= @order.address %></p>
      </div>
      <div>
        <p class="text-gray-400 mb-1">Trạng thái</p>
        <p class="text-gray-700 font-medium capitalize"><%= @order.status %></p>
      </div>
      <div>
        <p class="text-gray-400 mb-1">Tổng tiền</p>
        <p class="text-[#ee4d2d] font-semibold text-lg">
          <%= number_to_currency(@order.total, unit: "₫", precision: 0, format: "%n%u") %>
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-sm shadow-sm p-6 mb-6">
    <h2 class="text-base font-semibold text-gray-800 mb-4 pb-3 border-b">Sản Phẩm Đã Đặt</h2>
    <div class="space-y-3">
      <% @order.order_items.each do |item| %>
        <div class="flex justify-between text-sm border-b border-gray-50 pb-3 last:border-0">
          <span class="text-gray-700"><%= item.product_name %> <span class="text-gray-400">x<%= item.quantity %></span></span>
          <span class="text-gray-700 font-medium">
            <%= number_to_currency(item.total_price, unit: "₫", precision: 0, format: "%n%u") %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="text-center">
    <%= link_to "Tiếp Tục Mua Sắm", products_path,
          class: "inline-block bg-[#ee4d2d] hover:bg-[#d9431f] text-white font-medium px-8 py-3 rounded-sm" %>
  </div>
</div>