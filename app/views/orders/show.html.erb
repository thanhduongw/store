<div class="max-w-3xl mx-auto py-12 px-4 text-center">
  <div class="bg-green-50 border border-green-200 rounded-lg p-8 mb-8">
    <h1 class="text-3xl font-bold text-green-700 mb-2">Đặt hàng thành công!</h1>
    <p class="text-gray-600">Cảm ơn bạn đã mua hàng. Mã đơn hàng của bạn là:</p>
    <p class="text-2xl font-bold mt-2">#<%= @order.id %></p>
  </div>

  <div class="bg-white shadow rounded-lg p-6 text-left">
    <h2 class="text-xl font-bold mb-4">Thông tin đơn hàng</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 text-sm">
      <div>
        <p class="text-gray-500">Người nhận</p>
        <p class="font-medium"><%= @order.full_name %></p>
      </div>
      <div>
        <p class="text-gray-500">Số điện thoại</p>
        <p class="font-medium"><%= @order.phone %></p>
      </div>
      <div class="md:col-span-2">
        <p class="text-gray-500">Địa chỉ</p>
        <p class="font-medium"><%= @order.address %></p>
      </div>
      <div>
        <p class="text-gray-500">Trạng thái</p>
        <p class="font-medium capitalize"><%= @order.status %></p>
      </div>
      <div>
        <p class="text-gray-500">Tổng tiền</p>
        <p class="font-bold text-lg"><%= number_to_currency(@order.total, unit: "₫", precision: 0) %></p>
      </div>
    </div>

    <h3 class="font-bold mb-3">Sản phẩm đã đặt</h3>
    <div class="space-y-3">
      <% @order.order_items.each do |item| %>
        <div class="flex justify-between border-b pb-2">
          <span><%= item.product_name %> × <%= item.quantity %></span>
          <span><%= number_to_currency(item.total_price, unit: "₫", precision: 0) %></span>
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <%= link_to "Tiếp tục mua sắm", products_path, class: "bg-blue-600 text-white px-6 py-3 rounded-md hover:bg-blue-700" %>
  </div>
</div>