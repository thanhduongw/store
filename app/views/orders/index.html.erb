<div class="py-6 max-w-4xl mx-auto">
  <h1 class="text-xl font-semibold text-gray-800 mb-4">Đơn Hàng Của Tôi</h1>

  <!-- Status filter tabs -->
  <%
    tabs = [
      { label: "Tất cả",            status: nil },
      { label: "Chờ xử lý",         status: "pending" },
      { label: "Đã thanh toán",     status: "paid" },
      { label: "Đang vận chuyển",   status: "shipped" },
      { label: "Đã hủy",            status: "cancelled" }
    ]
  %>
  <div class="bg-white rounded-sm shadow-sm mb-4 flex overflow-x-auto">
    <% tabs.each do |tab| %>
      <%
        active = @status_filter == tab[:status]
        url    = tab[:status] ? orders_path(status: tab[:status]) : orders_path
      %>
      <%= link_to url,
            class: "flex-1 text-center py-3 text-sm font-medium whitespace-nowrap border-b-2 transition-colors #{active ? 'border-[#ee4d2d] text-[#ee4d2d]' : 'border-transparent text-gray-500 hover:text-[#ee4d2d] hover:border-[#ee4d2d]/40'}" do %>
        <%= tab[:label] %>
      <% end %>
    <% end %>
  </div>

  <% if @orders.empty? %>
    <div class="bg-white rounded-sm shadow-sm py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-200 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <p class="text-gray-400 mb-4">Chưa có đơn hàng nào.</p>
      <%= link_to "Mua sắm ngay", products_path,
            class: "inline-block bg-[#ee4d2d] hover:bg-[#d9431f] text-white font-medium px-6 py-2.5 rounded-sm text-sm" %>
    </div>
  <% else %>
    <div class="space-y-3">
      <% @orders.each do |order| %>
        <div class="bg-white rounded-sm shadow-sm overflow-hidden">

          <!-- Card header -->
          <div class="flex items-center justify-between px-5 py-3 bg-gray-50 border-b border-gray-100">
            <div class="flex items-center gap-3 text-xs text-gray-500">
              <span class="font-medium text-gray-700">#<%= order.id %></span>
              <span class="text-gray-300">·</span>
              <span><%= order.created_at.strftime("%H:%M · %d/%m/%Y") %></span>
            </div>
            <span class="text-xs font-semibold px-2.5 py-1 rounded-full <%= order.badge_class %>">
              <%= order.status_label %>
            </span>
          </div>

          <!-- Products -->
          <div class="divide-y divide-gray-50 px-5">
            <% order.order_items.each do |item| %>
              <div class="flex items-center gap-3 py-3">
                <!-- Thumbnail -->
                <div class="w-14 h-14 rounded border border-gray-100 bg-gray-50 overflow-hidden shrink-0">
                  <% if item.product&.images&.attached? %>
                    <%= image_tag item.product.images.first,
                          alt: item.product_name,
                          class: "w-full h-full object-cover" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  <% end %>
                </div>
                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <p class="text-sm text-gray-800 font-medium truncate"><%= item.product_name %></p>
                  <p class="text-xs text-gray-400 mt-0.5">Số lượng: <%= item.quantity %></p>
                </div>
                <!-- Price -->
                <p class="text-sm text-gray-700 shrink-0">
                  <%= number_to_currency(item.total_price, unit: "₫", precision: 0, format: "%n%u") %>
                </p>
              </div>
            <% end %>
          </div>

          <!-- Footer -->
          <div class="px-5 py-3 border-t border-gray-100 bg-gray-50/50">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <!-- Left: shipping info -->
              <div class="text-xs text-gray-500 min-w-0">
                <span class="inline-flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="truncate max-w-60"><%= order.address %></span>
                </span>
              </div>

              <!-- Right: total + actions -->
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-sm text-gray-500">Tổng:</span>
                <span class="text-base font-bold text-[#ee4d2d]">
                  <%= number_to_currency(order.total, unit: "₫", precision: 0, format: "%n%u") %>
                </span>

                <% if order.status == "pending" %>
                  <%= button_to cancel_order_path(order), method: :patch,
                        data: { turbo_confirm: "Hủy đơn hàng ##{order.id}?\nSau khi hủy sẽ không thể khôi phục." },
                        class: "text-xs border border-red-300 text-red-500 hover:bg-red-500 hover:text-white hover:border-red-500 px-3 py-1.5 rounded-sm cursor-pointer bg-white transition-colors" do %>
                    Hủy đơn
                  <% end %>
                <% end %>

                <%= link_to order_path(order),
                      class: "text-xs border border-[#ee4d2d] text-[#ee4d2d] hover:bg-[#ee4d2d] hover:text-white px-3 py-1.5 rounded-sm transition-colors" do %>
                  Xem chi tiết
                <% end %>
              </div>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  <% end %>
</div>
