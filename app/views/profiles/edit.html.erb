<div class="py-8 max-w-2xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to profile_path, class: "text-gray-400 hover:text-gray-600" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>
    <h1 class="text-xl font-semibold text-gray-800">Chỉnh Sửa Thông Tin</h1>
  </div>

  <div class="bg-white rounded-sm shadow-sm p-6">
    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-5" do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm">
          <ul class="list-disc list-inside space-y-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :first_name, "Tên", class: "block text-sm text-gray-600 mb-1" %>
          <%= form.text_field :first_name, required: true,
                class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
        </div>
        <div>
          <%= form.label :last_name, "Họ", class: "block text-sm text-gray-600 mb-1" %>
          <%= form.text_field :last_name, required: true,
                class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
        </div>
      </div>

      <div>
        <%= form.label :email_address, "Email", class: "block text-sm text-gray-600 mb-1" %>
        <%= form.email_field :email_address, required: true,
              class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
      </div>

      <div class="pt-4 border-t">
        <p class="text-sm font-medium text-gray-700 mb-4">Đổi mật khẩu <span class="font-normal text-gray-400">(để trống nếu không muốn đổi)</span></p>
        <div class="space-y-4">
          <div>
            <%= form.label :password, "Mật khẩu mới", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.password_field :password, autocomplete: "new-password",
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
          </div>
          <div>
            <%= form.label :password_confirmation, "Xác nhận mật khẩu mới", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.password_field :password_confirmation, autocomplete: "new-password",
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
          </div>
        </div>
      </div>

      <div class="flex gap-3 pt-2">
        <%= form.submit "Lưu thay đổi",
              class: "bg-[#ee4d2d] hover:bg-[#d9431f] text-white font-medium py-2 px-6 rounded-sm cursor-pointer text-sm" %>
        <%= link_to "Hủy", profile_path,
              class: "py-2 px-6 rounded-sm border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm" %>
      </div>
    <% end %>
  </div>
</div>
