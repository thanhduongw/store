<% content_for :title, "Thanh toán | Store" %>

<div class="py-4">
  <h1 class="text-lg font-medium text-gray-700 mb-4">Thanh Toán</h1>

  <%= form_with model: @order, url: checkout_path, class: "grid grid-cols-1 lg:grid-cols-3 gap-4" do |form| %>
    <div class="lg:col-span-2 space-y-4">
      <!-- Địa chỉ -->
      <div class="bg-white rounded-sm shadow-sm p-6">
        <div class="flex items-center gap-2 text-[#ee4d2d] font-medium mb-4 pb-3 border-b border-gray-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Địa Chỉ Nhận Hàng
        </div>

        <% if @order.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-4">
            <ul class="list-disc list-inside">
              <% @order.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <div>
            <%= form.label :full_name, "Họ và tên người nhận", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_field :full_name, required: true,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:border-[#ee4d2d] focus:ring-1 focus:ring-[#ee4d2d]/20" %>
          </div>
          <div>
            <%= form.label :phone, "Số điện thoại", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.telephone_field :phone, required: true,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:border-[#ee4d2d] focus:ring-1 focus:ring-[#ee4d2d]/20" %>
          </div>
          <div>
            <%= form.label :address, "Địa chỉ giao hàng", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_area :address, rows: 3, required: true,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:border-[#ee4d2d] focus:ring-1 focus:ring-[#ee4d2d]/20" %>
          </div>
          <div>
            <%= form.label :note, "Ghi chú (tùy chọn)", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_area :note, rows: 2,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2.5 text-sm focus:outline-none focus:border-[#ee4d2d] focus:ring-1 focus:ring-[#ee4d2d]/20" %>
          </div>
        </div>
      </div>

      <!-- Sản phẩm -->
      <div class="bg-white rounded-sm shadow-sm p-6">
        <h2 class="text-base font-medium text-gray-800 mb-4 pb-3 border-b border-gray-100">Sản Phẩm Đã Chọn</h2>
        <div class="space-y-4">
          <% @cart.cart_items.each do |item| %>
            <div class="flex items-center gap-4">
              <% if item.product.featured_image.attached? %>
                <%= image_tag item.product.featured_image.variant(resize_to_limit: [80, 80]),
                      class: "w-16 h-16 object-cover rounded-sm border border-gray-100" %>
              <% else %>
                <div class="w-16 h-16 rounded-sm bg-gray-100"></div>
              <% end %>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-700 line-clamp-1"><%= item.product.name %></p>
                <p class="text-xs text-gray-400 mt-0.5">Phân loại: Mặc định</p>
              </div>
              <div class="text-sm text-gray-500 shrink-0">x<%= item.quantity %></div>
              <div class="text-sm text-[#ee4d2d] font-medium w-28 text-right shrink-0">
                ₫<%= number_with_delimiter(item.total_price.to_i, delimiter: '.') %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Tổng kết -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-sm shadow-sm p-6 sticky top-24">
        <h2 class="text-base font-medium text-gray-800 mb-4 pb-3 border-b border-gray-100">Đơn Hàng</h2>
        <div class="flex justify-between text-sm text-gray-600 mb-2">
          <span>Tạm tính</span>
          <span>₫<%= number_with_delimiter(@cart.total_price.to_i, delimiter: '.') %></span>
        </div>
        <div class="flex justify-between text-sm text-gray-600 mb-2">
          <span>Phí vận chuyển</span>
          <span class="text-[#ee4d2d]">Miễn phí</span>
        </div>
        <div class="flex justify-between text-sm text-gray-600 mb-4 pb-4 border-b border-dashed border-gray-200">
          <span>Giảm giá</span>
          <span>₫0</span>
        </div>
        <div class="flex justify-between items-center mb-6">
          <span class="text-sm text-gray-600">Tổng cộng</span>
          <div class="text-right">
            <span class="text-2xl text-[#ee4d2d] font-medium">₫<%= number_with_delimiter(@cart.total_price.to_i, delimiter: '.') %></span>
            <p class="text-xs text-gray-400">(Đã bao gồm VAT)</p>
          </div>
        </div>
        <%= form.submit "Đặt Hàng",
              class: "w-full bg-[#ee4d2d] hover:bg-[#d9431f] text-white font-medium py-3 rounded-sm transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>