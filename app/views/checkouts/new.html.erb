<div class="py-6">
  <h1 class="text-lg font-medium text-gray-700 mb-4">Thanh Toán</h1>

  <%= form_with model: @order, url: checkout_path, class: "grid grid-cols-1 lg:grid-cols-3 gap-6" do |form| %>
    <div class="lg:col-span-2 space-y-4">
      <div class="bg-white rounded-sm shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-4 pb-3 border-b">Địa Chỉ Nhận Hàng</h2>

        <% if @order.errors.any? %>
          <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded mb-4">
            <ul class="list-disc list-inside">
              <% @order.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <div>
            <%= form.label :full_name, "Họ và tên người nhận", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_field :full_name, required: true,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
          </div>
          <div>
            <%= form.label :phone, "Số điện thoại", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.telephone_field :phone, required: true,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
          </div>
          <div>
            <%= form.label :address, "Địa chỉ giao hàng", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_area :address, rows: 3, required: true,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
          </div>
          <div>
            <%= form.label :note, "Ghi chú (tùy chọn)", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_area :note, rows: 2,
                  class: "w-full rounded-sm border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:border-[#ee4d2d]" %>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-sm shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-4 pb-3 border-b">Sản Phẩm</h2>
        <div class="space-y-3">
          <% @cart.cart_items.each do |item| %>
            <div class="flex items-center gap-4">
              <% if item.product.featured_image.attached? %>
                <%= image_tag item.product.featured_image.variant(resize_to_limit: [56, 56]),
                      alt: item.product.name,
                      class: "w-14 h-14 object-cover rounded border border-gray-100" %>
              <% else %>
                <div class="w-14 h-14 rounded bg-gray-100"></div>
              <% end %>
              <div class="flex-1 text-sm text-gray-700"><%= item.product.name %></div>
              <div class="text-sm text-gray-500">x<%= item.quantity %></div>
              <div class="text-sm text-[#ee4d2d] font-medium w-28 text-right">
                <%= number_to_currency(item.total_price, unit: "₫", precision: 0, format: "%n%u") %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="lg:col-span-1">
      <div class="bg-white rounded-sm shadow-sm p-6">
        <h2 class="text-base font-semibold text-gray-800 mb-4 pb-3 border-b">Đơn Hàng</h2>
        <div class="flex justify-between text-sm text-gray-600 mb-2">
          <span>Tạm tính</span>
          <span><%= number_to_currency(@cart.total_price, unit: "₫", precision: 0, format: "%n%u") %></span>
        </div>
        <div class="flex justify-between text-sm text-gray-600 mb-4">
          <span>Phí vận chuyển</span>
          <span>Miễn phí</span>
        </div>
        <div class="flex justify-between items-center pt-4 border-t mb-6">
          <span class="text-sm text-gray-600">Tổng cộng</span>
          <span class="text-2xl text-[#ee4d2d] font-semibold">
            <%= number_to_currency(@cart.total_price, unit: "₫", precision: 0, format: "%n%u") %>
          </span>
        </div>
        <%= form.submit "Đặt Hàng",
              class: "w-full bg-[#ee4d2d] hover:bg-[#d9431f] text-white font-medium py-3 rounded-sm cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>