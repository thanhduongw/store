<div class="max-w-5xl mx-auto">
  <h1 class="text-xl font-medium mb-6">Thanh Toán</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Form thông tin giao hàng -->
    <div class="lg:col-span-2">
      <div class="bg-white rounded-sm shadow-sm p-6">
        <h2 class="font-medium text-lg mb-5">Địa chỉ nhận hàng</h2>

        <%= form_with model: @order, url: checkout_path, class: "space-y-5" do |form| %>
          <% if @order.errors.any? %>
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded text-sm">
              <% @order.errors.full_messages.each do |msg| %>
                <p><%= msg %></p>
              <% end %>
            </div>
          <% end %>

          <div>
            <%= form.label :full_name, "Họ và tên", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_field :full_name, required: true,
                  class: "w-full border border-gray-300 rounded-sm px-3 py-2.5 focus:outline-none focus:border-[#EE4D2D]",
                  placeholder: "Nguyễn Văn A" %>
          </div>

          <div>
            <%= form.label :phone, "Số điện thoại", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.telephone_field :phone, required: true,
                  class: "w-full border border-gray-300 rounded-sm px-3 py-2.5 focus:outline-none focus:border-[#EE4D2D]",
                  placeholder: "09xxxxxxxx" %>
          </div>

          <div>
            <%= form.label :address, "Địa chỉ nhận hàng", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_area :address, rows: 3, required: true,
                  class: "w-full border border-gray-300 rounded-sm px-3 py-2.5 focus:outline-none focus:border-[#EE4D2D]",
                  placeholder: "Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" %>
          </div>

          <div>
            <%= form.label :note, "Lời nhắn (nếu có)", class: "block text-sm text-gray-600 mb-1" %>
            <%= form.text_area :note, rows: 2,
                  class: "w-full border border-gray-300 rounded-sm px-3 py-2.5 focus:outline-none focus:border-[#EE4D2D]",
                  placeholder: "Lưu ý cho người bán..." %>
          </div>

          <div class="pt-2">
            <%= form.submit "Đặt Hàng",
                  class: "w-full bg-[#EE4D2D] hover:bg-[#D73211] text-white py-3.5 rounded-sm font-medium text-base cursor-pointer transition" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Tóm tắt đơn hàng -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-sm shadow-sm p-5 sticky top-24">
        <h2 class="font-medium mb-4">Đơn hàng của bạn</h2>

        <div class="space-y-3 max-h-64 overflow-y-auto mb-4">
          <% @cart.cart_items.each do |item| %>
            <div class="flex gap-3 text-sm">
              <div class="w-12 h-12 shrink-0">
                <% if item.product.featured_image.attached? %>
                  <%= image_tag item.product.featured_image.variant(resize_to_limit: [50, 50]),
                        class: "w-full h-full object-cover rounded-sm border" %>
                <% end %>
              </div>
              <div class="flex-1">
                <div class="line-clamp-2"><%= item.product.name %></div>
                <div class="text-gray-400 text-xs mt-0.5">x<%= item.quantity %></div>
              </div>
              <div class="text-[#EE4D2D] whitespace-nowrap">
                ₫<%= number_with_delimiter(item.total_price.to_i) %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="border-t pt-4 space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Tạm tính</span>
            <span>₫<%= number_with_delimiter(@cart.total_price.to_i) %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Phí vận chuyển</span>
            <span class="text-green-600">Miễn phí</span>
          </div>
        </div>

        <div class="border-t mt-4 pt-4">
          <div class="flex justify-between items-center">
            <span class="font-medium">Tổng thanh toán</span>
            <span class="text-2xl text-[#EE4D2D] font-medium">
              ₫<%= number_with_delimiter(@cart.total_price.to_i) %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>