<%# QUAN TRỌNG: form_with phải dùng model: [:admin, product] để submit đúng vào
    /admin/products (namespace admin), tránh bị lỗi post nhầm sang route công khai. %>
<%= form_with(model: [ :admin, product ], class: "space-y-6") do |form| %>
  <% if product.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-sm">
      <h3 class="font-medium"><%= pluralize(product.errors.count, "lỗi") %> ngăn không cho lưu:</h3>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% product.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="md:col-span-2 space-y-6">
      <div>
        <%= form.label :name, "Tên sản phẩm", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :name, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
      </div>

      <div>
        <%= form.label :description, "Mô tả", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description, rows: 5, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :price, "Giá bán (₫)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :price, step: 1000, min: 0, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
        </div>

        <div>
          <%= form.label :compare_at_price, "Giá gốc (để hiện giảm giá)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :compare_at_price, step: 1000, min: 0, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :inventory_count, "Số lượng tồn kho", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :inventory_count, min: 0, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
        </div>

        <div>
          <%= form.label :sku, "Mã SKU", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.text_field :sku, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :status, "Trạng thái", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :status, Product::STATUSES.map { |s| [s.humanize, s] }, {}, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
        </div>

        <div>
          <%= form.label :category_id, "Danh mục", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: "Chọn danh mục" }, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <label class="block text-sm font-medium text-gray-700">Ảnh sản phẩm</label>

      <div class="aspect-square w-full max-w-56 rounded-sm border border-dashed border-gray-300 bg-gray-50 flex items-center justify-center overflow-hidden">
        <% if product.featured_image.attached? %>
          <%= image_tag product.featured_image.variant(resize_to_limit: [300, 300]),
                alt: product.name.presence || "Ảnh sản phẩm",
                class: "w-full h-full object-contain" %>
        <% else %>
          <span class="text-xs text-gray-400">Chưa có ảnh</span>
        <% end %>
      </div>

      <%= form.file_field :featured_image, accept: "image/png,image/jpeg,image/webp",
            class: "block w-full text-sm text-gray-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-sm file:border-0 file:bg-[#ee4d2d] file:text-white hover:file:bg-[#d73211]" %>
      <p class="text-xs text-gray-400">JPEG, PNG hoặc WEBP, tối đa 5MB.</p>

      <% if product.featured_image.attached? %>
        <label class="flex items-center gap-2 text-sm text-gray-600">
          <%= check_box_tag "product[remove_featured_image]", "1", false, class: "rounded-sm border-gray-300 text-[#ee4d2d] focus:ring-[#ee4d2d]" %>
          Xóa ảnh hiện tại
        </label>
      <% end %>
    </div>
  </div>

  <div class="pt-4 flex gap-3">
    <%= form.submit "Lưu sản phẩm", class: "bg-[#ee4d2d] hover:bg-[#d73211] text-white font-medium py-2 px-6 rounded-sm cursor-pointer" %>
    <%= link_to "Hủy", admin_products_path, class: "py-2 px-6 rounded-sm border border-gray-300 text-gray-600 hover:bg-gray-50" %>
  </div>
<% end %>