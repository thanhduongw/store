<div class="mb-6 flex items-center justify-between">
  <div>
    <%= link_to "← Quay lại danh sách", admin_products_path, class: "text-sm text-gray-500 hover:text-[#ee4d2d]" %>
    <h1 class="text-2xl font-bold mt-1"><%= @product.name %></h1>
  </div>
  <div class="flex gap-2">
    <%= link_to "Sửa", edit_admin_product_path(@product), class: "px-4 py-2 rounded-sm bg-[#ee4d2d] hover:bg-[#d73211] text-white text-sm font-medium" %>
    <%= link_to "Xóa", admin_product_path(@product),
          data: { turbo_method: :delete, turbo_confirm: "Bạn chắc chắn muốn xóa sản phẩm này?" },
          class: "px-4 py-2 rounded-sm border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="aspect-square rounded-sm border bg-gray-50 flex items-center justify-center overflow-hidden">
    <% if @product.featured_image.attached? %>
      <%= image_tag @product.featured_image.variant(resize_to_limit: [400, 400]),
            alt: @product.name, class: "w-full h-full object-contain" %>
    <% else %>
      <span class="text-xs text-gray-400">Chưa có ảnh</span>
    <% end %>
  </div>

  <div class="md:col-span-2 bg-white shadow-sm rounded-sm p-6 space-y-3 text-sm">
    <p><strong>SKU:</strong> <%= @product.sku.presence || "—" %></p>
    <p><strong>Danh mục:</strong> <%= @product.category&.name || "Chưa phân loại" %></p>
    <p><strong>Giá bán:</strong> <%= number_to_currency(@product.price, unit: "₫", precision: 0) %></p>
    <p><strong>Giá gốc:</strong> <%= @product.compare_at_price.present? ? number_to_currency(@product.compare_at_price, unit: "₫", precision: 0) : "—" %></p>
    <p><strong>Tồn kho:</strong> <%= @product.inventory_count %></p>
    <p><strong>Trạng thái:</strong> <%= @product.status.humanize %></p>
    <p class="pt-2"><strong>Mô tả:</strong></p>
    <p class="text-gray-600 whitespace-pre-line"><%= @product.description.presence || "Không có mô tả." %></p>
  </div>
</div>