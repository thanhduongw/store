<div class="mb-6 flex items-center justify-between">
  <div>
    <%= link_to "← Quay lại danh sách",
          admin_products_path,
          class: "text-sm text-gray-500 hover:text-[#ee4d2d]" %>

    <h1 class="text-2xl font-bold mt-1">
      <%= @product.name %>
    </h1>
  </div>

  <div class="flex gap-2">
    <%= link_to "Sửa",
          edit_admin_product_path(@product),
          class: "px-4 py-2 rounded-sm bg-[#ee4d2d] hover:bg-[#d73211] text-white text-sm font-medium" %>

    <%= link_to "Xóa",
          admin_product_path(@product),
          data: {
            turbo_method: :delete,
            turbo_confirm: "Bạn chắc chắn muốn xóa sản phẩm này?"
          },
          class: "px-4 py-2 rounded-sm border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">

  <!-- Hình ảnh sản phẩm -->
  <div class="bg-white shadow-sm rounded-sm p-4">

    <% if @product.images.attached? %>

      <div class="aspect-square rounded-sm border bg-gray-50 flex items-center justify-center overflow-hidden">
        <%= image_tag @product.images.first,
              alt: @product.name,
              class: "w-full h-full object-contain" %>
      </div>

      <% if @product.images.count > 1 %>
        <div class="grid grid-cols-4 gap-2 mt-3">

          <% @product.images.each do |image| %>
            <div class="aspect-square rounded-sm border bg-gray-50 overflow-hidden">
              <%= image_tag image,
                    alt: @product.name,
                    class: "w-full h-full object-cover" %>
            </div>
          <% end %>

        </div>
      <% end %>

    <% else %>

      <div class="aspect-square rounded-sm border bg-gray-50 flex items-center justify-center">
        <div class="text-center text-gray-400">

          <svg
            class="w-16 h-16 mx-auto opacity-40"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2 2 2 0 002 2z"
            />
          </svg>

          <p class="text-xs mt-2">
            Chưa có ảnh
          </p>

        </div>
      </div>

    <% end %>

  </div>

  <!-- Thông tin sản phẩm -->
  <div class="md:col-span-2 bg-white shadow-sm rounded-sm p-6">

    <div class="space-y-4 text-sm">

      <!-- SKU -->
      <div class="flex flex-col sm:flex-row sm:items-center border-b border-gray-100 pb-3">
        <span class="font-medium text-gray-500 sm:w-32">
          SKU
        </span>

        <span class="text-gray-800">
          <%= @product.sku.presence || "—" %>
        </span>
      </div>

      <!-- Category -->
      <div class="flex flex-col sm:flex-row sm:items-center border-b border-gray-100 pb-3">
        <span class="font-medium text-gray-500 sm:w-32">
          Danh mục
        </span>

        <span class="text-gray-800">
          <%= @product.category&.name || "Chưa phân loại" %>
        </span>
      </div>

      <!-- Price -->
      <div class="flex flex-col sm:flex-row sm:items-center border-b border-gray-100 pb-3">
        <span class="font-medium text-gray-500 sm:w-32">
          Giá bán
        </span>

        <span class="text-[#ee4d2d] text-lg font-medium">
          <%= number_to_currency(
                @product.price,
                unit: "₫",
                precision: 0
              ) %>
        </span>
      </div>


      <!-- Inventory -->
      <div class="flex flex-col sm:flex-row sm:items-center border-b border-gray-100 pb-3">
        <span class="font-medium text-gray-500 sm:w-32">
          Tồn kho
        </span>

        <span class="<%= @product.inventory_count.zero? ? 'text-red-500 font-medium' : 'text-gray-800' %>">
          <%= @product.inventory_count %> sản phẩm
        </span>
      </div>

      <!-- Status -->
      <div class="flex flex-col sm:flex-row sm:items-center border-b border-gray-100 pb-3">
        <span class="font-medium text-gray-500 sm:w-32">
          Trạng thái
        </span>

        <span>
          <% if @product.status == "active" %>
            <span class="inline-flex px-2 py-1 rounded-full bg-green-50 text-green-700 text-xs font-medium">
              Đang bán
            </span>
          <% else %>
            <span class="inline-flex px-2 py-1 rounded-full bg-gray-100 text-gray-500 text-xs font-medium">
              Bản nháp
            </span>
          <% end %>
        </span>
      </div>

      <!-- Description -->
      <div>
        <p class="font-medium text-gray-500 mb-2">
          Mô tả
        </p>

        <div class="text-gray-600 whitespace-pre-line leading-6">
          <%= @product.description.presence || "Không có mô tả." %>
        </div>
      </div>

    </div>

  </div>
</div>