<div class="flex justify-between items-center mb-4">
  <h1 class="text-xl font-semibold text-gray-800">Tất cả sản phẩm</h1>

  <%= link_to "+ Thêm sản phẩm",
        new_admin_product_path,
        class: "bg-[#ee4d2d] hover:bg-[#d73211] text-white text-sm font-medium px-4 py-2 rounded-sm" %>
</div>

<%= form_with url: admin_products_path,
      method: :get,
      class: "bg-white rounded-sm shadow-sm p-4 mb-4 flex flex-wrap gap-3 items-center" do |form| %>

  <%= form.text_field :q,
        value: params[:q],
        placeholder: "Tìm theo tên hoặc SKU...",
        class: "rounded-sm border-gray-300 text-sm flex-1 min-w-48 focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>

  <%= form.select :status,
        options_for_select(
          [["Tất cả trạng thái", ""]] +
          Product::STATUSES.map { |s| [s.humanize, s] },
          params[:status]
        ),
        {},
        class: "rounded-sm border-gray-300 text-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>

  <%= form.submit "Lọc",
        class: "bg-gray-100 hover:bg-gray-200 text-sm px-4 py-2 rounded-sm cursor-pointer" %>
<% end %>

<div class="bg-white shadow-sm rounded-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-100">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Sản phẩm
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Danh mục
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Giá
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Tồn kho
          </th>

          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">
            Trạng thái
          </th>

          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">
            Thao tác
          </th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-100">
        <% @products.each do |product| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <div class="flex items-center gap-3">

                <!-- Thumbnail -->
                <div class="w-12 h-12 rounded border bg-gray-50 flex-shrink-0 flex items-center justify-center overflow-hidden">
                  <% if product.images.attached? %>
                    <%= image_tag product.images.first,
                          alt: product.name,
                          class: "w-full h-full object-cover",
                          loading: "lazy" %>
                  <% else %>
                    <span class="text-[10px] text-gray-400">
                      Không ảnh
                    </span>
                  <% end %>
                </div>

                <!-- Product information -->
                <div class="min-w-0">
                  <div class="font-medium text-gray-800 line-clamp-1">
                    <%= product.name %>
                  </div>

                  <div class="text-xs text-gray-400">
                    <%= product.sku.presence || "Chưa có SKU" %>
                  </div>
                </div>

              </div>
            </td>

            <!-- Category -->
            <td class="px-4 py-3 text-sm text-gray-600">
              <%= product.category&.name || "—" %>
            </td>

            <!-- Price -->
            <td class="px-4 py-3 text-sm">
              <span class="text-[#ee4d2d] font-medium">
                <%= number_to_currency(
                      product.price,
                      unit: "₫",
                      precision: 0
                    ) %>
              </span>

            </td>

            <!-- Inventory -->
            <td class="px-4 py-3 text-sm <%= product.inventory_count.zero? ? 'text-red-500 font-medium' : 'text-gray-600' %>">
              <%= product.inventory_count %>
            </td>

            <!-- Status -->
            <td class="px-4 py-3">
              <span class="px-2 py-1 text-xs rounded-full <%= product.status == 'active' ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                <%= product.status.humanize %>
              </span>
            </td>

            <!-- Actions -->
            <td class="px-4 py-3 text-right text-sm whitespace-nowrap">
              <%= link_to "Xem",
                    admin_product_path(product),
                    class: "text-gray-500 hover:text-[#ee4d2d] mr-3" %>

              <%= link_to "Sửa",
                    edit_admin_product_path(product),
                    class: "text-[#ee4d2d] hover:underline mr-3" %>

              <%= link_to "Xóa",
                    admin_product_path(product),
                    data: {
                      turbo_method: :delete,
                      turbo_confirm: "Bạn chắc chắn?"
                    },
                    class: "text-gray-400 hover:text-red-600" %>
            </td>
          </tr>
        <% end %>

        <% if @products.empty? %>
          <tr>
            <td colspan="6" class="px-4 py-16 text-center text-gray-400 text-sm">
              Không tìm thấy sản phẩm nào.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination -->
<% if @pagy && @pagy.pages > 1 %>
  <div class="mt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm">

    <p class="text-gray-500">
      Hiển thị
      <%= @pagy.from %>–<%= @pagy.to %>
      /
      <%= @pagy.count %>
      sản phẩm
    </p>

    <nav class="flex items-center gap-1">
      <%== @pagy.series_nav %>
    </nav>

  </div>
<% end %>