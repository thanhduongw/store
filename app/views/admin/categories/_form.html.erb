<%= form_with(model: [ :admin, category ], class: "space-y-6 max-w-md") do |form| %>
  <% if category.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-sm">
      <h3 class="font-medium"><%= pluralize(category.errors.count, "lỗi") %> ngăn không cho lưu:</h3>
      <ul class="mt-2 list-disc list-inside text-sm">
        <% category.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Tên danh mục", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "block w-full rounded-sm border-gray-300 shadow-sm focus:border-[#ee4d2d] focus:ring-[#ee4d2d]" %>
  </div>

  <div class="pt-2 flex gap-3">
    <%= form.submit "Lưu", class: "bg-[#ee4d2d] hover:bg-[#d73211] text-white font-medium py-2 px-6 rounded-sm cursor-pointer" %>
    <%= link_to "Hủy", admin_categories_path, class: "py-2 px-6 rounded-sm border border-gray-300 text-gray-600 hover:bg-gray-50" %>
  </div>
<% end %>