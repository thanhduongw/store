<div class="flex justify-between items-center mb-4">
  <h1 class="text-xl font-semibold text-gray-800">Danh mục sản phẩm</h1>
  <%= link_to "+ Thêm danh mục", new_admin_category_path, class: "bg-[#ee4d2d] hover:bg-[#d73211] text-white text-sm font-medium px-4 py-2 rounded-sm" %>
</div>

<div class="bg-white shadow-sm rounded-sm overflow-hidden">
  <table class="min-w-full divide-y divide-gray-100">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tên danh mục</th>
        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">Số sản phẩm</th>
        <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">Thao tác</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @categories.each do |category| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 font-medium text-gray-800"><%= category.name %></td>
          <td class="px-4 py-3 text-sm text-gray-600"><%= category.products_count %></td>
          <td class="px-4 py-3 text-right text-sm">
            <%= link_to "Sửa", edit_admin_category_path(category), class: "text-[#ee4d2d] hover:underline mr-3" %>
            <%= link_to "Xóa", admin_category_path(category), data: { turbo_method: :delete, turbo_confirm: "Xóa danh mục này? Sản phẩm sẽ chuyển về 'Chưa phân loại'." }, class: "text-gray-400 hover:text-red-600" %>
          </td>
        </tr>
      <% end %>

      <% if @categories.empty? %>
        <tr><td colspan="3" class="px-4 py-16 text-center text-gray-400 text-sm">Chưa có danh mục nào.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>