<%# app/views/admin/orders/show.html.erb %>
<div class="mb-6">
  <%= link_to "← Quay lại danh sách", admin_orders_path, class: "text-blue-600 hover:underline" %>
</div>

<h1 class="text-2xl font-bold mb-6">Đơn hàng #<%= @order.id %></h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 bg-white p-6 rounded-lg shadow">
    <h2 class="font-bold mb-4">Sản phẩm</h2>
    <% @order.order_items.each do |item| %>
      <div class="flex justify-between py-2 border-b">
        <span><%= item.product_name %> × <%= item.quantity %></span>
        <span><%= number_to_currency(item.total_price, unit: "₫", precision: 0) %></span>
      </div>
    <% end %>
    <div class="flex justify-between font-bold text-lg mt-4">
      <span>Tổng cộng</span>
      <span><%= number_to_currency(@order.total, unit: "₫", precision: 0) %></span>
    </div>
  </div>

  <div class="bg-white p-6 rounded-lg shadow">
    <h2 class="font-bold mb-4">Thông tin giao hàng</h2>
    <p class="mb-2"><strong>Người nhận:</strong> <%= @order.full_name %></p>
    <p class="mb-2"><strong>SĐT:</strong> <%= @order.phone %></p>
    <p class="mb-4"><strong>Địa chỉ:</strong> <%= @order.address %></p>

    <h2 class="font-bold mb-2">Cập nhật trạng thái</h2>
    <%= form_with model: [:admin, @order], class: "space-y-3" do |form| %>
      <%= form.select :status, Order::STATUSES.map { |s| [s.humanize, s] }, {}, class: "w-full rounded border-gray-300" %>
      <%= form.submit "Cập nhật", class: "w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700" %>
    <% end %>
  </div>
</div>