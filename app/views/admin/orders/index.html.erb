<%# app/views/admin/orders/index.html.erb %>
<h1 class="text-2xl font-bold mb-6">Quản lý đơn hàng</h1>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Mã đơn</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Khách hàng</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Tổng tiền</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Trạng thái</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Ngày đặt</th>
        <th class="px-6 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @orders.each do |order| %>
        <tr>
          <td class="px-6 py-4 font-medium">#<%= order.id %></td>
          <td class="px-6 py-4"><%= order.full_name %></td>
          <td class="px-6 py-4"><%= number_to_currency(order.total, unit: "₫", precision: 0) %></td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800">
              <%= order.status %>
            </span>
          </td>
          <td class="px-6 py-4 text-sm text-gray-500"><%= order.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td class="px-6 py-4 text-right">
            <%= link_to "Xem", admin_order_path(order), class: "text-blue-600 hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>