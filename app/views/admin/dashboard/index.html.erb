<%# app/views/admin/dashboard/index.html.erb %>
<% content_for :title, "Dashboard" %>

<h1 class="text-3xl font-bold mb-8">Dashboard</h1>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <div class="bg-white p-6 rounded-lg shadow">
    <p class="text-gray-500 text-sm">Tổng sản phẩm</p>
    <p class="text-3xl font-bold mt-1"><%= @products_count %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <p class="text-gray-500 text-sm">Tổng đơn hàng</p>
    <p class="text-3xl font-bold mt-1"><%= @orders_count %></p>
  </div>
  <div class="bg-white p-6 rounded-lg shadow">
    <p class="text-gray-500 text-sm">Đơn chờ xử lý</p>
    <p class="text-3xl font-bold mt-1 text-orange-600"><%= @pending_orders %></p>
  </div>
</div>