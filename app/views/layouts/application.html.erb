<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Store" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Store">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= link_to cart_path, class: "relative text-gray-700 hover:text-blue-600" do %>
  <span>Giỏ hàng</span>
    <% if current_cart.total_quantity > 0 %>
      <span class="absolute -top-2 -right-3 bg-red-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">
        <%= current_cart.total_quantity %>
      </span>
    <% end %>
  <% end %>
  <% if authenticated? && Current.user.admin? %>
  <%= link_to "Admin", admin_root_path, class: "text-sm text-purple-600 hover:underline" %>
<% end %>
    <nav class="bg-white shadow-sm border-b">
      <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
        <%= link_to "Store", root_path, class: "text-xl font-bold text-gray-800" %>

        <div class="flex items-center gap-4">
          <% if authenticated? %>
            <span class="text-sm text-gray-600">Xin chào, <%= Current.user.full_name %></span>
            <%= button_to "Đăng xuất", session_path, method: :delete, class: "text-sm text-red-600 hover:underline" %>
          <% else %>
            <%= link_to "Đăng nhập", new_session_path, class: "text-sm text-gray-700 hover:text-blue-600" %>
            <%= link_to "Đăng ký", sign_up_path, class: "text-sm bg-blue-600 text-white px-3 py-1.5 rounded-md hover:bg-blue-700" %>
          <% end %>
        </div>
      </div>
    </nav>
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="container mx-auto mt-28 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
