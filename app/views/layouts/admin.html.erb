<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} - Kênh Người Bán" : "Kênh Người Bán" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#f5f5f5] text-gray-800">
    <header class="bg-[#ee4d2d] text-white sticky top-0 z-20">
      <div class="max-w-[1400px] mx-auto px-4 h-14 flex items-center justify-between">
        <%= link_to admin_root_path, class: "flex items-center gap-2 font-semibold text-lg" do %>
          <span>Kênh Người Bán</span>
        <% end %>
        <div class="flex items-center gap-4 text-sm">
          <%= link_to "Về trang chủ", root_path, class: "hover:opacity-80" %>
          <span class="opacity-90"><%= Current.user.full_name %></span>
          <%= button_to "Đăng xuất", session_path, method: :delete, class: "bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-sm" %>
        </div>
      </div>
    </header>

    <div class="max-w-[1400px] mx-auto flex items-start">
      <aside class="w-56 flex-shrink-0 bg-white min-h-[calc(100vh-3.5rem)] border-r border-gray-100 py-4 hidden md:block">
        <nav class="space-y-1 text-sm">
          <% [
               [ "Tổng quan", admin_root_path, admin_root_path ],
               [ "Sản phẩm", admin_products_path, admin_products_path ],
               [ "Danh mục", admin_categories_path, admin_categories_path ],
               [ "Đơn hàng", admin_orders_path, admin_orders_path ],
             ].each do |label, path, active_path| %>
            <%= link_to label, path,
                  class: "block px-5 py-2.5 border-l-[3px] #{ request.path.start_with?(active_path) ? 'border-[#ee4d2d] text-[#ee4d2d] bg-orange-50 font-medium' : 'border-transparent text-gray-600 hover:bg-gray-50' }" %>
          <% end %>
        </nav>
      </aside>

      <main class="flex-1 min-w-0 p-4 md:p-6">
        <% if notice.present? %>
          <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-sm mb-4 text-sm">
            <%= notice %>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-sm mb-4 text-sm">
            <%= alert %>
          </div>
        <% end %>

        <%= yield %>
      </main>
    </div>
  </body>
</html>